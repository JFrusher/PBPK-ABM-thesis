# Minimal, reproducibility-focused repository policy
# Ignore everything by default, then allow only source/config/docs needed to rebuild and rerun.
/*

# Keep repository metadata and essential top-level build/docs files.
!/.gitignore
!/.github/
!/.github/**
!/CITATION.cff
!/LICENSE
!/README.md
!/VERSION.txt
!/Makefile
!/main.cpp

# Keep primary code and configuration trees.
!/core/
!/core/**
!/custom_modules/
!/custom_modules/**
!/modules/
!/modules/**
!/config/
!/config/**
!/scripts/
!/scripts/**
!/matlab/
!/matlab/**
!/docs/
!/docs/**
!/protocols/
!/protocols/**
!/tests/
!/tests/**
!/unit_tests/
!/unit_tests/**

# Keep bundled project dependencies required to build/run locally.
!/addons/
!/addons/**
!/BioFVM/
!/BioFVM/**
!/licenses/
!/licenses/**

# Keep only source and lightweight reproducibility inputs from allowed folders.
*.asv
*.bak
*.tmp
*.temp
*.swp
*.swo

# Build products and binary artifacts.
*.o
*.obj
*.so
*.dll
*.dylib
*.a
*.lib
*.exe
bin/

# Python/IDE cache.
__pycache__/
*.pyc
*.pyo
.venv/
.vscode/
.history/

# Logs and scheduler outputs.
*.log
slurm-*.out
slurm-*.err

# Generated analysis outputs and heavy artifacts.
output/
logs/
MC_results/
analysis_pack_*/
comparison_pack_*/
simulation_results_*/
Sim_results_*/
Physicell_results_*/
tmp_export_*/

# Large non-source artifacts.
*.zip
*.fig
*.png
*.jpg
*.jpeg
*.mp4
*.gif
*.svg

# Data dumps and ad-hoc exports are ignored by default.
# If a specific input dataset must be tracked, add an explicit negation rule for that file.
*.csv

# Keep config and known run-input files in version control.
!config/**/*.csv
!config/**/*.xml
!scripts/**/*.csv
!scripts/**/*.txt
!scripts/**/*.json
!matlab/**/*.csv